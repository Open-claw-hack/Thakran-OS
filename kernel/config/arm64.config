# ============================================================================
# Thakran OS — ARM64 Kernel Configuration
# ============================================================================
# Ultra-lightweight kernel for ARM64 devices:
#   - Raspberry Pi 3/4/5
#   - Apple Silicon (M-series, via Asahi)
#   - Qualcomm Snapdragon ARM laptops
#   - Generic UEFI ARM64 devices
#
# Target: 512MB RAM minimum, boots in <3 seconds
# ============================================================================

# ─── Core Architecture ─────────────────────────────────────────────────────
CONFIG_ARM64=y
CONFIG_ARCH_BCM2835=y          # Raspberry Pi
CONFIG_ARCH_APPLE=y            # Apple Silicon
CONFIG_ARCH_QCOM=y             # Qualcomm Snapdragon
CONFIG_ARCH_ROCKCHIP=y         # RK3588 and similar SBCs
CONFIG_ARCH_SUNXI=y            # Allwinner (Pine64, etc.)
CONFIG_64BIT=y

# ─── Performance (Lightweight) ────────────────────────────────────────────
CONFIG_HZ_300=y                # 300Hz — balanced for lightweight
CONFIG_NO_HZ_IDLE=y            # Tickless idle for power savings
CONFIG_PREEMPT=y               # Responsive desktop
CONFIG_SMP=y
CONFIG_NR_CPUS=8               # Support up to 8 cores

# ─── Memory (Low RAM Optimization) ────────────────────────────────────────
CONFIG_SWAP=y                  # Essential for 512MB devices
CONFIG_ZRAM=y                  # Compressed RAM disk (★ critical for low RAM)
CONFIG_ZSWAP=y                 # Compressed swap cache
CONFIG_TRANSPARENT_HUGEPAGE=y  # Only on devices with enough RAM
CONFIG_COMPACTION=y            # Memory defragmentation
CONFIG_CMA=y                  # Contiguous Memory Allocator (for GPU)
CONFIG_MEMORY_HOTPLUG=n        # Not needed, save memory

# ─── Storage & Filesystems ────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_F2FS_FS=y               # Flash-Friendly FS (★ great for SD cards)
CONFIG_SQUASHFS=y              # For live boot / overlays
CONFIG_SQUASHFS_ZSTD=y
CONFIG_FUSE_FS=y               # AppImage support
CONFIG_OVERLAY_FS=y            # OverlayFS for containers

# ─── GPIO / Pi Hardware ──────────────────────────────────────────────────
CONFIG_GPIO_SYSFS=y
CONFIG_I2C=y
CONFIG_SPI=y
CONFIG_PWM=y
CONFIG_GPIOLIB=y

# ─── GPU / Display ───────────────────────────────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_V3D=y               # Raspberry Pi VideoCore VI
CONFIG_DRM_VC4=y               # Raspberry Pi VideoCore IV
CONFIG_DRM_PANFROST=y          # Mali (Rockchip, Allwinner)
CONFIG_DRM_LIMA=y              # Mali-400/450
CONFIG_DRM_ASAHI=m             # Apple Silicon GPU (module)
CONFIG_DRM_AMDGPU=n            # Not needed on ARM
CONFIG_DRM_I915=n              # Not needed on ARM
CONFIG_DRM_NOUVEAU=n           # Not needed on ARM
CONFIG_DRM_SIMPLEDRM=y         # Fallback framebuffer

# ─── Networking ──────────────────────────────────────────────────────────
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y            # Pi Bluetooth
CONFIG_USB_NET_DRIVERS=y

# ─── USB & Input ────────────────────────────────────────────────────────
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWCOTG=y            # Pi USB OTG
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_KEYBOARD=y

# ─── Sound ──────────────────────────────────────────────────────────────
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_BCM2835=y           # Pi audio

# ─── AI Workload Support ───────────────────────────────────────────────
# (Lighter than x86_64 — focus on CPU-only inference)
CONFIG_NEON=y                  # ARM NEON SIMD (★ critical for AI performance)
CONFIG_CRYPTO_AES_ARM64_NEON=y

# ─── Containers (for Waydroid / Android) ──────────────────────────────
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_MEMORY=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y

# Binder (for Android/Waydroid)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y

# ─── Security ──────────────────────────────────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECCOMP=y

# ─── Power Management (★ critical for battery devices) ────────────────
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y  # Smart frequency scaling
CONFIG_ARM_SCPI_CPUFREQ=y
CONFIG_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y

# ─── Remove Bloat ─────────────────────────────────────────────────────
CONFIG_DEBUG_KERNEL=n          # No debug (saves memory)
CONFIG_STAGING=n               # No staging drivers
CONFIG_HAMRADIO=n
CONFIG_AMATEUR_RADIO=n
CONFIG_INFINIBAND=n
CONFIG_ISDN=n
CONFIG_ATM=n
CONFIG_PCMCIA=n
CONFIG_WIMAX=n
CONFIG_FIREWIRE=n
CONFIG_NFC=n
CONFIG_CAIF=n
CONFIG_MOST=n

# ─── Module Support ───────────────────────────────────────────────────
CONFIG_MODULES=y
CONFIG_MODULE_COMPRESS_ZSTD=y  # Smaller modules on disk
CONFIG_MODULE_UNLOAD=y

# ─── Boot ────────────────────────────────────────────────────────────
CONFIG_EFI=y
CONFIG_CMDLINE="console=tty1 quiet splash loglevel=3 thakran.tier=auto"
