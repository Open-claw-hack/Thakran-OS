# ============================================================================
# Thakran OS — Custom Kernel Configuration (x86_64)
# ============================================================================
# Optimized for:
#   - Desktop/laptop use with AI workloads
#   - GPU acceleration (NVIDIA, AMD, Intel)
#   - NPU support (Intel, Qualcomm)
#   - Low-latency scheduling
#   - Enhanced security (AppArmor, Landlock)
#   - Modern hardware support
# ============================================================================

# ─── General Setup ──────────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-thakran"
CONFIG_DEFAULT_HOSTNAME="thakran"
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_USELIB=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# ─── Processor & Architecture ──────────────────────────────────────────────
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NUMA=y

# CPU frequency scaling (for power management)
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# Intel specific
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_IDLE=y
CONFIG_INTEL_RAPL=m

# AMD specific
CONFIG_X86_AMD_PSTATE=y

# ─── Memory Management (Optimized for AI Workloads) ────────────────────────
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_KSM=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_ZRAM=m
CONFIG_MEMORY_HOTPLUG=y
CONFIG_COMPACTION=y
CONFIG_PAGE_REPORTING=y
CONFIG_CGROUP_HUGETLB=y

# Large memory support for AI models
CONFIG_HIGHMEM64G=y
CONFIG_SPARSEMEM=y
CONFIG_SPARSEMEM_VMEMMAP=y

# ─── Storage & Filesystems ─────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y

# NVMe support
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

# SATA/AHCI
CONFIG_SATA_AHCI=y
CONFIG_ATA=y

# ─── Networking ─────────────────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m

# WiFi
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y

# Bluetooth
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m

# ─── GPU & Display ─────────────────────────────────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y

# Intel GPU
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m

# AMD GPU
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y

# NVIDIA (Nouveau open-source + proprietary module support)
CONFIG_DRM_NOUVEAU=m
CONFIG_MODULE_SIG=n

# Framebuffer
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y

# ─── AI / ML Hardware Acceleration ─────────────────────────────────────────
# CUDA/ROCm support (user-space drivers, kernel provides DMA & IOMMU)
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_DEFAULT_PASSTHROUGH=y

# DMA support for GPU compute
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=256

# Intel NPU / VPU
CONFIG_DRM_ACCEL=y

# USB accelerators (Coral TPU etc.)
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y

# PCIe for GPU/NPU cards
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_DPC=y
CONFIG_HOTPLUG_PCI=y

# ─── Sound ──────────────────────────────────────────────────────────────────
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC=m

# PipeWire support (user-space, but kernel needs ALSA)
CONFIG_SND_ALOOP=m
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y

# ─── Input Devices ─────────────────────────────────────────────────────────
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_TABLET=y
CONFIG_HID=y
CONFIG_USB_HID=y

# ─── Power Management ──────────────────────────────────────────────────────
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_ACPI=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y

# ─── Virtualization (for testing & containers) ─────────────────────────────
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m

# Container support
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y

# ─── Security ──────────────────────────────────────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_PAGE_TABLE_ISOLATION=y

# Module signing
CONFIG_MODULE_SIG_SHA256=y

# ─── Modules & Firmware ────────────────────────────────────────────────────
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"

# ─── Debugging (disabled for production) ───────────────────────────────────
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_KERNEL=n
CONFIG_PRINTK=y
CONFIG_LOG_BUF_SHIFT=17

# ─── EFI Boot ──────────────────────────────────────────────────────────────
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_EFIVAR_FS=y
